rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function staff() { return request.auth != null && role() in ['personal','admin']; }
    function admin() { return request.auth != null && role() == 'admin'; }
    match /users/{id} { allow read: if request.auth != null && (request.auth.uid == id || admin()); allow write: if admin(); }
    match /{col}/{id} {
      allow read: if col in ['anunturi','resurse','pagini','evenimente','profesori','consiliu','succese'];
      allow write: if staff() && col in ['anunturi','resurse','pagini','evenimente','profesori','consiliu','succese'];
    }
    match /feedback/{id} { allow create: if true; allow read, delete: if admin(); }
  }
}
